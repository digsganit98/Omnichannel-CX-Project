APP_ENV=local
LOG_LEVEL=INFO
DATABASE_PATH=data/cx_phase1.db

# Protect internal APIs and inbound webhook endpoints.
ADMIN_API_KEY=replace-with-a-long-random-value
EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-value
WHATSAPP_VERIFY_TOKEN=replace-with-meta-verification-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# Required for live WhatsApp outbound replies.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Use log for API-only local smoke tests. Use live with Docker Mailpit or real SMTP.
OUTBOUND_DELIVERY_MODE=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=support@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Local RAG stack.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=cx_knowledge_base
RAG_EMBEDDING_DIM=384
# Set this to sentence_transformers for semantic vectors.
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
RAG_TOP_K=4
