APP_ENV=local
LOG_LEVEL=INFO
DATABASE_PATH=data/cx_phase1.db

# Protect internal APIs and inbound webhook endpoints.
ADMIN_API_KEY=replace-with-a-long-random-value
EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-value
WHATSAPP_VERIFY_TOKEN=replace-with-meta-verification-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# Local-only WhatsApp simulation. Never enable this in production.
WHATSAPP_LOCAL_TEST_MODE=false
WHATSAPP_TEST_SIGNATURE=replace-with-a-long-random-test-value

# Required for live WhatsApp outbound replies and POST /test/whatsapp/send with provider=meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Use log for API-only local smoke tests. Use live with Docker Mailpit or real SMTP.
OUTBOUND_DELIVERY_MODE=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=support@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Optional external CRM or Jira ticket synchronization.
# Use disabled, generic, or jira.
CRM_PROVIDER=disabled
CRM_BASE_URL=
CRM_API_TOKEN=
CRM_USER_EMAIL=
CRM_PROJECT_KEY=
CRM_ISSUE_TYPE=Task
CRM_TIMEOUT_SECONDS=15
CRM_MAX_RETRIES=2

# Local RAG stack.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=cx_knowledge_base
RAG_EMBEDDING_DIM=384
# Sentence-transformers is the default. Use hashing only for constrained smoke tests.
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT_SECONDS=30
RAG_TOP_K=4
