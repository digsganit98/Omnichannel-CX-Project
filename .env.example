APP_ENV=local
LOG_LEVEL=INFO
DATABASE_PATH=data/cx_phase1.db

# ── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=xxxxx

# ── Analytics UI Login ───────────────────────────────────────────────────────
# Credentials for the /analytics-ui login page
ANALYTICS_USERNAME=admin
ANALYTICS_PASSWORD=changeme
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-random-32-char-string
EMAIL_WEBHOOK_SECRET=yyyy
WHATSAPP_VERIFY_TOKEN=replace-with-meta-verification-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# Local-only WhatsApp simulation. Never enable this in production.
WHATSAPP_LOCAL_TEST_MODE=false
WHATSAPP_TEST_SIGNATURE=replace-with-a-long-random-test-value

# Required for live WhatsApp outbound replies.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
NGROK_AUTHTOKEN=
# Leave BLANK unless you are testing WhatsApp. A reserved ngrok domain allows ONE
# online session on the free tier, and the hosted instance holds the team domain -
# filling this in either fails with ERR_NGROK_334 or steals the tunnel and routes
# real WhatsApp messages to your laptop. ngrok also does not start by default;
# see docker-compose.yml -> profiles: ["tunnel"].
NGROK_DOMAIN=

# ── Groq LLM ────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
# Recommended model: openai/gpt-oss-20b (fast) or openai/gpt-oss-120b (accurate)
# The Llama models were removed from Groq and now 404 on every call.
GROQ_API_KEY=groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# -- LLM Observability -------------------------------------------------------
# Local token/cost ledger is enabled by default. It records model, latency,
# token counts, estimated cost, channel, intent, and workflow IDs.
LLM_OBSERVABILITY_ENABLED=true
# Override provider rates per 1M tokens when pricing changes.
LLM_COST_RATES_JSON={"openai/gpt-oss-20b":{"input":0.075,"output":0.3},"openai/gpt-oss-120b":{"input":0.15,"output":0.6}}

# Optional Langfuse export. Raw prompt/response capture is disabled by default
# for BFSI safety; enable LANGFUSE_CAPTURE_IO only with masked/synthetic data.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_IO=false

# ── PII Masking ────────────────────────────────────────────────────────────
# Masks PAN, Aadhar, phone, email, card numbers, and the resolved customer's own
# name before any text is sent to Groq; restores the customer's name in the final
# reply. See services/pii_service/. Default true — only disable for debugging.
PII_MASKING_ENABLED=true

# ── Gmail IMAP — Email Inbox (Inbound) ───────────────────────────────────────
# Polls the support inbox for new customer emails and routes them through the
# agentic pipeline automatically.
# Uses the same Gmail App Password as SMTP below.
# Gmail IMAP setup:
#   1. Enable IMAP in Gmail → Settings → See all settings → Forwarding and POP/IMAP
#   2. Use the same 16-char App Password from myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_ENABLED defaults to false in code (apps/api/main.py). Turn it on ONLY when
# deliberately testing email: this mailbox is shared with the hosted instance, and
# two pollers race for it - the first to poll marks a message read and the other
# never sees it, so a demo email silently vanishes.
# IMAP_ENABLED=false
IMAP_USERNAME=your_support_mailbox@example.com
IMAP_PASSWORD=gmail_app_password_here_16_char
IMAP_MAILBOX=INBOX
EMAIL_POLL_INTERVAL_SECONDS=30

# ── SMTP / Gmail — Email Outbound ────────────────────────────────────────────
# Gmail setup:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" → copy the 16-char password
OUTBOUND_DELIVERY_MODE=live
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=your_support_mailbox@example.com
SMTP_USERNAME=your_support_mailbox@example.com
SMTP_PASSWORD=gmail_app_password_here_16_char
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ── JIRA / CRM ───────────────────────────────────────────────────────────────
# JIRA setup:
#   1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
#   2. Create an API token → copy it
#   3. Set CRM_PROJECT_KEY to your Jira project key (e.g. BFSI, CX, SUPP)
CRM_PROVIDER=jira
CRM_BASE_URL=https://ganitomnichannel.atlassian.net
CRM_API_TOKEN=jira_api_token_here
CRM_USER_EMAIL=fathima21062002@gmail.com
CRM_PROJECT_KEY=SUP
CRM_ISSUE_TYPE=Service Request
CRM_TIMEOUT_SECONDS=15
CRM_MAX_RETRIES=2

# ── Neo4j Graph Database ─────────────────────────────────────────────────────
# Local Docker: uses docker-compose neo4j service (bolt://neo4j:7687)
# Local dev (outside Docker): bolt://localhost:7687
# Neo4j Aura (cloud): neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password_here
NEO4J_ENABLED=true

# ── OpenSearch / RAG ─────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=cx_knowledge_base
RAG_EMBEDDING_DIM=384
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4

# ── Ollama (optional local LLM fallback) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_ENABLED=false
OLLAMA_TIMEOUT_SECONDS=30
